FROM node:22-alpine AS build
WORKDIR /web
COPY package.json package-lock.json ./
# First build resolves pinned direct packages and downloads transitive dependencies.
# Generate/commit package-lock.json for reproducible submission packaging.
RUN npm ci --no-audit --no-fund
COPY tsconfig.json index.html ./
COPY src ./src
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.chat.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
