# Local development only; use secrets management for nonlocal deployments.
# Change HOST ports here. Container-to-container traffic still uses standard internal ports.
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark_local_dev_only
POSTGRES_DB=spark

# Host ports (Windows localhost). Pick any free ports if these conflict.
API_PORT=18080
POSTGRES_PORT=15432
OLLAMA_PORT=11435
# Reserved for a future Chainlit frontend service.
CHAINLIT_PORT=18081

# Optional offline SapBERT service: CPU default, GPU via compose.gpu.yaml.
SAPBERT_PORT=18082
SAPBERT_DEVICE=auto

# Dynamic Knowledge Retrieval
UMLS_API_KEY=
NCBI_API_KEY=

# Task 2 reproducibility / zero-egress baseline
SPARK_MODEL_SEED=42
SPARK_ENABLE_RESOURCE_EXPLORER=0
